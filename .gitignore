# Ignore everything by default.
*

# Keep this file visible to Git.
!.gitignore

# Keep project design notes visible to Git.
!COWATCH_MULTIDISPLAY_MEDIA_CONCEPTS.md

# Allow traversal into the Android app source tree.
!app/
!app/src/
!app/src/main/

# Keep only source code and Android resources.
!app/src/main/java/
!app/src/main/java/**
!app/src/main/kotlin/
!app/src/main/kotlin/**
!app/src/main/res/
!app/src/main/res/**
