<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.hieuld.cowatch.permission.SHARE_PLAYBACK" />

    <application>
        <service
            android:name="com.ivi.pid.sharing.PidPlaybackShareService"
            android:exported="true"
            android:permission="com.hieuld.cowatch.permission.SHARE_PLAYBACK" />
        <activity
            android:name="com.ivi.pid.ui.FrontPlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true" />

        <activity
            android:name="com.ivi.pid.ui.VideoLibraryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
