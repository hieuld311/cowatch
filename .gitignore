# Ignore everything by default.
*

# Keep this file visible to Git.
!.gitignore


# Allow traversal to Android resources.
!app/
!app/src/
!app/src/main/

# Keep Android resources visible; source files stay ignored unless already tracked.
!app/src/main/res/
!app/src/main/res/**

# Keep bundled exhibition media assets visible.
!app/src/main/assets/
!app/src/main/assets/**
